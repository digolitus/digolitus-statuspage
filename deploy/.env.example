# Copy to deploy/.env to override defaults. Never commit deploy/.env.
# All values are optional for local use.

# Host port for the application (always bound to 127.0.0.1).
STATUSPAGE_PORT=8080

# Local database credentials (the database is not published to the host).
POSTGRES_DB=statuspage
POSTGRES_USER=statuspage
POSTGRES_PASSWORD=local-dev-only

# Backend settings.
DB_MAX_CONNS=10
DB_AUTO_MIGRATE=true
# false = read-only public API (admin routes are not registered).
ADMIN_API_ENABLED=true
LOG_LEVEL=info
