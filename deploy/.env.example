# Copy to deploy/.env to override defaults. Never commit deploy/.env.
# All values are optional for local use.

# Host port for the application (always bound to 127.0.0.1).
STATUSPAGE_PORT=8080

# Local database credentials (the database is not published to the host).
POSTGRES_DB=statuspage
POSTGRES_USER=statuspage
POSTGRES_PASSWORD=local-dev-only

# Backend settings.
DB_MAX_CONNS=10
DB_AUTO_MIGRATE=true
# false = read-only public API (admin routes are not registered).
ADMIN_API_ENABLED=true
LOG_LEVEL=info

# Third-party status pages (Atlassian Statuspage, e.g. githubstatus.com).
EXTERNAL_STATUS_SYNC=true
EXTERNAL_STATUS_INTERVAL=2m
# Only for status pages hosted on private networks. Keep false unless needed
# (it widens the reach of server-side requests).
EXTERNAL_STATUS_ALLOW_PRIVATE_NETWORKS=false

# Admin sessions. This local stack is plain HTTP, so the cookie cannot carry
# the Secure flag; set true whenever the app is served over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_TTL=12h
SESSION_IDLE_TIMEOUT=2h

# Subscriptions (notifications by e-mail, webhook and Slack; RSS/Atom always on).
# Self-service subscriptions need SMTP: every request is confirmed by e-mail
# (double opt-in). Without SMTP_HOST the public form offers only the feeds,
# and administrators can still create webhook/Slack integrations.
SITE_NAME=Digolitus Status Page
# Public address used in e-mail links (required with SMTP_HOST).
PUBLIC_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# Secret: keep only in deploy/.env or a secret manager.
SMTP_PASSWORD=
SMTP_FROM=
# starttls (587), tls (465) or none (local test servers only).
SMTP_TLS=starttls
# Delivery worker (outbox). Safe on several replicas (rows are claimed with
# FOR UPDATE SKIP LOCKED); set false to keep delivery off a replica.
NOTIFY_WORKER=true
NOTIFY_INTERVAL=10s
# Only for webhooks on private networks. Keep false unless needed.
NOTIFY_ALLOW_PRIVATE_NETWORKS=false
